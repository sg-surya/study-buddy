# LM Studio (primary for local Gemma) — OpenAI-compatible server
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
# Google AI Studio (fallback) — only if you also want cloud Gemma
GEMMA_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
# Postgres (optional — notebook persistence on Vercel; auto-injected by Vercel Storage/Neon)
POSTGRES_URL=
